{% set label = paragraph.field_mega_menu_links_list_label.value %}
{% set label_link = paragraph.field_mega_menu_links_list_label_link.0 %}
<div class = "ucb-mega-menu-column">
  <strong class = "ucb-mega-menu-column-label">
    {% if label_link and label_link.url %}
      <a href="{{ label_link.url|render }}">{{ label }}</a>
    {% else %}
      {{ label }}
    {% endif %}
  </strong>
  <ul class = "ucb-mega-menu-column-links-wrapper">
    {{ content.field_mega_menu_links_list_links|render }}
  </ul>
</div>
